#!/usr/bin/env ruby
require "openssl"
require "securerandom"
require "fileutils"
root = File.expand_path("..", __dir__)
Dir.chdir(root) do
  abort "O .env já existe. Preserve-o e gere novas chaves apenas em uma rotação planejada." if File.exist?(".env") || File.exist?("secrets/license-private.pem")
  FileUtils.mkdir_p("secrets", mode: 0700)
  FileUtils.mkdir_p("geoip")
  key = OpenSSL::PKey.generate_key("ED25519")
  File.write("secrets/license-private.pem", key.private_to_pem, mode: "wx", perm: 0600)
  File.write("secrets/license-public.pem", key.public_to_pem, mode: "wx", perm: 0644)
  password = SecureRandom.hex(32)
  env = File.read(".env.example").sub("SECRET_KEY_BASE=", "SECRET_KEY_BASE=#{SecureRandom.hex(64)}").sub("POSTGRES_PASSWORD=", "POSTGRES_PASSWORD=#{password}").sub("CHANGE_ME", password).sub("RELEASE_CI_TOKEN=", "RELEASE_CI_TOKEN=#{SecureRandom.hex(32)}")
  File.write(".env", env, mode: "wx", perm: 0600)
  puts "Criados .env e o par de chaves em secrets/. As chaves não foram exibidas."
  puts "Configure as chaves do Appwrite no .env. Em Linux, permita leitura da chave privada somente ao UID 10001 do container."
end
