#!/usr/bin/env bash
# Executado no servidor, a partir do snapshot enviado pelo GitHub Actions.
set -Eeuo pipefail
umask 077

project=${1:?Informe o diretório de produção}
revision=${2:?Informe o SHA do commit}
probe_mode=${3:-local}
[[ "$probe_mode" == local || "$probe_mode" == external ]] || { echo 'Modo de verificação inválido' >&2; exit 1; }
[[ "$revision" =~ ^[a-f0-9]{40}$ ]] || { echo 'SHA inválido' >&2; exit 1; }
project=$(cd "$project" && pwd -P)
release=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
[[ "$release" == "$project/.deploy/releases/"* ]] || { echo 'Snapshot fora do diretório de deploy' >&2; exit 1; }
for command in docker flock; do
  command -v "$command" >/dev/null || { echo "Comando obrigatório ausente: $command" >&2; exit 1; }
done
test -s "$project/.env"
test -s "$project/secrets/license-private.pem"
test -d "$project/geoip"
mkdir -p "$project/.deploy/backups"
exec 9>"$project/.deploy/deploy.lock"
flock -w 1800 9 || { echo 'Outro deploy está em andamento' >&2; exit 1; }

image="proser-studio-dashboard:ci-$revision"
printf 'services:\n  web:\n    image: %s\n' "$image" > "$release/compose.deploy.yml"
compose=(docker compose --project-directory "$project" -p proser-studio-dashboard
  -f "$release/compose.yml" -f "$release/compose.deploy.yml")
previous="$project"
if [[ -L "$project/.deploy/current" ]]; then
  previous=$(cd "$project/.deploy/current" && pwd -P)
fi
rollback=(docker compose --project-directory "$project" -p proser-studio-dashboard -f "$previous/compose.yml")
previous_image=$(docker inspect --format '{{.Image}}' proser-studio-dashboard)
test -n "$previous_image"

# A stack já deve existir; o deploy nunca inicializa ou recria PostgreSQL/Redis.
for service in postgres redis; do
  container=$("${compose[@]}" ps -q "$service")
  test -n "$container"
  status=$(docker inspect --format '{{.State.Health.Status}}' "$container")
  [[ "$status" == healthy ]] || { echo "$service não está saudável" >&2; exit 1; }
done

echo "Compilando o commit $revision"
docker build --label "org.opencontainers.image.revision=$revision" -t "$image" "$release"
"${compose[@]}" config --quiet
backup="$project/.deploy/backups/$(date -u +%Y%m%dT%H%M%SZ)-$revision.sql.gz"
echo 'Fazendo backup do PostgreSQL antes das migrations'
"${compose[@]}" exec -T postgres pg_dump -U proser -d proser --no-owner --no-acl | gzip > "$backup"
test -s "$backup"

echo 'Aplicando migrations com a nova imagem'
# run reuses the image built above; --no-build is supported by up, not run.
"${compose[@]}" run --rm --no-deps web bundle exec rails db:migrate

restore_web() {
  echo 'Deploy falhou; restaurando a imagem anterior do painel' >&2
  local override="$release/compose.rollback.yml"
  printf 'services:\n  web:\n    image: %s\n' "$previous_image" > "$override"
  if "${rollback[@]}" -f "$override" up -d --no-deps --no-build --wait --wait-timeout 180 web; then
    echo 'Imagem anterior restaurada. Migrations e backup foram preservados.' >&2
  else
    echo 'Falha ao restaurar a imagem anterior; intervenção necessária.' >&2
  fi
}

echo 'Atualizando somente o serviço web e aguardando o healthcheck'
if ! "${compose[@]}" up -d --no-deps --no-build --wait --wait-timeout 180 web; then
  restore_web
  exit 1
fi

# O CI consulta as rotas públicas de fora do servidor. O lock e o rollback
# permanecem neste processo até receber o resultado pelo canal SSH autenticado.
if [[ "$probe_mode" == external ]]; then
  trap 'restore_web; exit 1' HUP TERM
  echo "PROSER_PUBLIC_HEALTH_READY $revision"
  verdict=''
  if ! IFS= read -r -t 180 verdict || [[ "$verdict" != "PROSER_PUBLIC_HEALTH_OK $revision" ]]; then
    restore_web
    exit 1
  fi
  trap - HUP TERM
else
  for endpoint in https://app.proser.studio/up https://api.proser.studio/up \
    https://app.proser.studio/api/v1/releases; do
    echo "Verificando HTTPS: $endpoint"
    if ! docker exec proser-studio-dashboard curl -fsS --max-time 30 --retry 3 --retry-delay 2 \
      --user-agent 'Proser-Deploy-Healthcheck/1.0' "$endpoint" >/dev/null; then
      restore_web
      exit 1
    fi
  done
fi

ln -sfn "releases/$(basename "$release")" "$project/.deploy/current.next"
mv -Tf "$project/.deploy/current.next" "$project/.deploy/current"
printf '%s\n' "$revision" > "$project/.deploy/revision"
echo "Deploy saudável: $revision"
