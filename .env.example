RAILS_ENV=production
DASHBOARD_URL=https://app.proser.studio
API_URL=https://api.proser.studio
ADMIN_GOOGLE_EMAILS=dwassano@gmail.com
INITIAL_INSTALLATION_LIMIT=20
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://proser:CHANGE_ME@postgres:5432/proser
